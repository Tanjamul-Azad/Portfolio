# ─────────────────────────────────────────────
# Site URL
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────
# AI Chat providers
#
# /api/chat tries these in order and falls back to the next one on failure, so
# any single key is enough — set none and the assistant reports itself as
# unconfigured rather than erroring. Only GEMINI_API_KEY was documented before,
# though the route has always read all four.
# ─────────────────────────────────────────────
# 1. Groq — https://console.groq.com/keys
GROQ_API_KEY=

# 2. Zhipu GLM — https://open.bigmodel.cn
GLM_API_KEY=

# 3. Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ─────────────────────────────────────────────
# Contact Form Email (Resend)
# Get your key at: https://resend.com/api-keys
# Free tier: 100 emails/day, 3,000/month
# ─────────────────────────────────────────────
RESEND_API_KEY=

# The "from" address for contact form emails.
# With free Resend tier use: onboarding@resend.dev
# With a verified domain use: Portfolio Contact <contact@yourdomain.com>
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ─────────────────────────────────────────────
# Content Editor ("Portfolio Studio" at /admin)
# The editor only runs during local development (npm run dev) and is fully
# disabled (404) in production. Put the real values in .env.local (gitignored).
# ─────────────────────────────────────────────

# The secret password used to log in at http://localhost:3000/admin
ADMIN_PASSWORD=choose-a-strong-password

# Signs the admin session cookie. Optional but recommended.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ─────────────────────────────────────────────
# Search engine verification (optional)
#
# Google Search Console > Add property > HTML tag: copy only the content="..."
# value, not the whole tag. Leave blank until you have it — the meta tag is
# omitted entirely when unset.
# ─────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ─────────────────────────────────────────────
# Live content editor (/admin)
#
# The editor is always available on `npm run dev`. It is exposed on the deployed
# site ONLY when all three of these are set — otherwise every /admin route 404s.
#
# GITHUB_TOKEN: a fine-grained Personal Access Token limited to this one
# repository, with Contents: Read and write. Nothing else. Saving from the
# deployed editor commits to the repo, which triggers the normal rebuild.
# Create one at https://github.com/settings/personal-access-tokens
#
# ADMIN_SESSION_SECRET must be different from ADMIN_PASSWORD — production
# refuses to start the editor otherwise, so one leak cannot compromise both.
# Generate with:  openssl rand -hex 32
# ─────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=Tanjamul-Azad
GITHUB_REPO=Portfolio
GITHUB_BRANCH=main
